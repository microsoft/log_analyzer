{
  "_comment": "Generic example signature pack. Copy to sut/settings.<name>.json (git-ignored) and tune it for your platform. Each signature: ERROR = any error_text matches (OR) unless a whitelist_text also matches; PASS = fails when a pass_text is missing; JSON = all key/value pairs must match (AND). Matching is case-insensitive substring, no regex.",
  "dedup_mode": "term",
  "error_signatures": [
    {
      "description": "Linux dmesg suspected errors",
      "match_type": "ERROR",
      "file": "dmesg*.log",
      "error_text": [
        "Severity=emerg",
        "Severity=alert",
        "Severity=crit",
        "Severity=err",
        "Hardware Error",
        "Machine check",
        "Kernel panic",
        "Call Trace"
      ],
      "whitelist_text": [
        "DEBUG",
        "SGX disabled by BIOS",
        "ip_local_port_range"
      ],
      "stop_on_fail_check": "false",
      "comment": "Kernel log errors. Keywords relationship is OR. No regex."
    },
    {
      "description": "PCIe AER / DPC events",
      "match_type": "ERROR",
      "file": "dmesg*.log",
      "error_text": [
        "AER: Uncorrected",
        "AER: Multiple Uncorrected",
        "DPC: containment event",
        "PCIe Bus Error: severity=Uncorrected",
        "Link Down"
      ],
      "whitelist_text": [
        "severity=Corrected"
      ],
      "stop_on_fail_check": "false",
      "comment": "Uncorrectable PCIe errors and downstream port containment."
    },
    {
      "description": "Linux syslog / journal errors",
      "match_type": "ERROR",
      "file": "*syslog*.log",
      "error_text": [
        "segfault",
        "Out of memory",
        "I/O error",
        "blk_update_request",
        "EXT4-fs error",
        "nvme",
        "timed out"
      ],
      "whitelist_text": [
        "DEBUG"
      ],
      "stop_on_fail_check": "false",
      "comment": "Common user-space and storage errors. Keywords relationship is OR."
    },
    {
      "description": "BMC SEL suspected events (text export)",
      "match_type": "ERROR",
      "file": "*sel*.log",
      "error_text": [
        "error",
        "fail",
        "critical",
        "degraded",
        "Uncorrectable"
      ],
      "whitelist_text": [
        "non-critical",
        "non-error",
        "Lower Critical going low",
        "Upper Critical going high",
        "Correctable error",
        "OS graceful shutdown",
        "Log Area Reset/Cleared"
      ],
      "stop_on_fail_check": "false",
      "comment": "Already human-readable SEL text (for example 'ipmitool sel elist'). No decoding is performed."
    },
    {
      "description": "Windows System event log suspected errors",
      "match_type": "ERROR",
      "file": "SystemEvtParsed.csv",
      "error_text": [
        "Error",
        "Critical"
      ],
      "whitelist_text": [
        "DEBUG",
        "Correctable error",
        "Application Popup",
        "The previous system shutdown",
        "The Device Setup Manager service"
      ],
      "stop_on_fail_check": "false",
      "comment": "Windows event log exported one entry per line. Keywords relationship is OR."
    },
    {
      "description": "Redfish-style event log critical entries",
      "match_type": "JSON",
      "file": "*event_log*.json",
      "error_text": [
        { "Severity": "Critical" }
      ],
      "whitelist_text": [],
      "stop_on_fail_check": "false",
      "comment": "JSON check. Key/value pairs relationship is AND."
    },
    {
      "description": "Test summary must report PASS",
      "match_type": "PASS",
      "file": "test_summary*.log",
      "pass_text": [
        "Overall result: PASS"
      ],
      "stop_on_fail_check": "false",
      "comment": "Fails when the pass text is missing from the matched file."
    }
  ]
}